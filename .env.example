# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, = 뒤에 발급받은 키를 붙여 넣으세요.
# .env 파일은 절대 다른 사람에게 보내거나 GitHub에 올리지 마세요.
# (.gitignore 에 이미 등록되어 있어 자동으로 제외됩니다)
# ─────────────────────────────────────────────────────────────

# 한국수출입은행 현재환율 API 인증키 (권장: 은행 매매기준율 + 최근 45일 추이)
# 비워 두면 ExchangeRate-API 공개 주소(키 불필요, 하루 1회 갱신 국제 시세)를 대신 씁니다.
KOREAEXIM_API_KEY=

# (선택) ExchangeRate-API 키. 없으면 키 없는 공개 주소를 씁니다.
# EXCHANGERATE_API_KEY=
# (선택) 환율 출처 고정: koreaexim 또는 exchangerate-api
# FX_PROVIDER=

# 네이버 검색 API (선택: 없으면 Google 뉴스만 사용합니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 뉴스 검색어 (선택: 쉼표로 구분)
# NEWS_KEYWORDS_KO=의료기기 수출,의료기기 인허가,체외진단 수출
# NEWS_KEYWORDS_EN=FDA medical device,EU MDR medical device,NMPA medical device

# 환율을 며칠 치 불러올지 (선택: 기본 45, 주말은 자동 제외)
# FX_DAYS=45
